{
  "name": "red-point-church-app",
  "version": "17.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "release-check": "node scripts/release-check.mjs",
    "preflight": "node scripts/preflight.mjs",
    "build:android:preview": "npx eas build --platform android --profile preview",
    "build:android:production": "npx eas build --platform android --profile production",
    "build:ios:production": "npx eas build --platform ios --profile production",
    "submit:android": "npx eas submit --platform android --profile production",
    "submit:ios": "npx eas submit --platform ios --profile production",
    "verify:production": "npm run preflight && npm run release-check && npm run check:production-config && npm run typecheck && npm run doctor",
    "check:production-config": "node scripts/production-config-check.mjs",
    "deploy:assistant": "node scripts/deployment-assistant.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:backend-config": "node scripts/backend-config-check.mjs",
    "deploy:backend": "node scripts/deploy-backend.mjs",
    "backend:check": "node scripts/backend-deployment-check.mjs",
    "verify:backend": "npm run backend:check && npm run check:production-config && npm run check:live",
    "check:live": "node scripts/live-production-check.mjs",
    "setup:production": "node scripts/setup-production.mjs",
    "verify:setup": "npm run preflight && npm run release-check && npm run backend:check && npm run setup:production",
    "backend:launch-gate": "node scripts/backend-launch-gate.mjs",
    "verify:backend-launch": "npm run backend:check && npm run backend:launch-gate",
    "guided:deploy": "node scripts/guided-deploy.mjs",
    "verify:deployment": "node scripts/guided-deploy.mjs --check",
    "admin-agent": "node scripts/admin-agent.mjs",
    "admin-surface-check": "node scripts/admin-surface-check.mjs",
    "verify:admin": "npm run admin-surface-check && npm run admin-agent -- plan && npm run admin-workflow-check && npm run release-check && npm run typecheck",
    "ai:loop": "node scripts/ai-operational-loop.mjs",
    "ai:plan": "npm run ai:loop",
    "admin-workflow-e2e": "node --env-file=.env scripts/admin-workflow-e2e.mjs",
    "admin-workflow-check": "node scripts/admin-workflow-verifier.mjs",
    "admin-runtime-readiness": "node --env-file=.env scripts/admin-runtime-readiness.mjs",
    "admin-workflow-e2e:check": "node --env-file=.env scripts/admin-workflow-e2e.mjs --check"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "2.112.4",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-image-picker": "~57.0.16",
    "expo-notifications": "~57.0.16",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
